{
  "name": "cliniscope-healthcare-contradiction-detector",
  "private": true,
  "version": "1.0.0",
  "description": "Evidence-first healthcare record contradiction detection with source-level traceability, context-aware discrepancy analysis, and an auditable human-review workflow. Built for PS-11R3.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "demo:generate": "node scripts/generate-demo-documents.mjs",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "dexie": "^4.0.10",
    "lucide-react": "^0.460.0",
    "mammoth": "^1.8.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "docx": "^9.0.3",
    "fake-indexeddb": "^6.0.0",
    "pdf-lib": "^1.17.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  }
}
