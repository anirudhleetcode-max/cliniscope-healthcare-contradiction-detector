# ---------------------------------------------------------------------------
# Frontend (Vite, build time). These values are PUBLIC: never put secrets here.
# ---------------------------------------------------------------------------
# Base path the static build is served from ("./" works for any host).
VITE_BASE_PATH=./
# Maximum upload size in megabytes (default 10).
VITE_MAX_UPLOAD_MB=10
# Optional default shared-workspace API URL pre-filled in About & settings.
VITE_API_BASE_URL=

# ---------------------------------------------------------------------------
# Shared-workspace API server (server/). Server-side only.
# ---------------------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
# Directory for the SQLite database and private original files (use a persistent volume).
CLINISCOPE_DATA_DIR=./data
# Comma-separated browser origins allowed to call the API (exact match).
CLINISCOPE_ALLOWED_ORIGINS=https://anirudhleetcode-max.github.io,http://localhost:5173
# Allow self-service account creation (true for a demo; false + create-user for controlled access).
CLINISCOPE_ALLOW_REGISTRATION=false
CLINISCOPE_SESSION_TTL_HOURS=8
CLINISCOPE_MAX_UPLOAD_MB=10

# Optional AI-assisted reasoning (Anthropic). Leave empty to disable AI.
ANTHROPIC_API_KEY=
CLINISCOPE_AI_MODEL=claude-opus-5-5
CLINISCOPE_AI_TIMEOUT_MS=120000
# Server-side refusal fallback (beta) on the Claude API; set false to disable.
CLINISCOPE_AI_FALLBACKS=true
# Override only for testing against a local stand-in; defaults to https://api.anthropic.com.
CLINISCOPE_ANTHROPIC_BASE_URL=
